# Portfolio Server Environment Configuration
PORT=3000
NODE_ENV=production

# Admin Passcode & Authentication
# Replace with a strong, private passcode
ADMIN_PASSWORD=change_this_to_your_secure_password
RECRUITER_PASSWORD=Recruiter2026

# Cryptographic Session Secret (Used to sign HMAC session tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_32_byte_hex_secret

# Allowed CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=https://abhinashmaddheshiya.dev,https://abhinashmadd.github.io

# Webhook Verification Secret (Used for HMAC-SHA256 signature checks)
WEBHOOK_SECRET=change_this_to_a_random_32_byte_webhook_secret
