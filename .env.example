# Portfolio Server Environment Configuration
PORT=3000
NODE_ENV=production

# Admin & Recruiter Authentication (Salted PBKDF2 Hashes)
# Generate a salted hash using:
# node -e "const crypto = require('crypto'); const s = crypto.randomBytes(16).toString('hex'); const h = crypto.pbkdf2Sync('YOUR_PASSWORD', s, 100000, 32, 'sha256').toString('hex'); console.log('pbkdf2$100000$' + s + '$' + h);"
ADMIN_PASSWORD_HASH=pbkdf2$100000$your_random_salt_hex$your_derived_hash_hex
RECRUITER_PASSWORD_HASH=pbkdf2$100000$your_random_salt_hex$your_derived_hash_hex

# Cryptographic Session Secret (Used to sign HMAC session tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_32_byte_hex_secret

# Allowed CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=https://abhinashmaddheshiya.dev,https://abhinashmadd.github.io

# Webhook Verification Secret (Used for HMAC-SHA256 signature checks)
WEBHOOK_SECRET=change_this_to_a_random_32_byte_webhook_secret
